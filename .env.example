# Kopieren nach .env und anpassen.

# --- Datenbank ---------------------------------------------------------------
DATABASE_URL="postgresql://mcsaas:dev_only_not_secret@127.0.0.1:5432/mcsaas?schema=public"

# --- Queue -------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# --- Auth --------------------------------------------------------------------
# Mit `openssl rand -base64 32` erzeugen. In Produktion zwingend eigener Wert.
BETTER_AUTH_SECRET="bitte-ersetzen-openssl-rand-base64-32"
# Entwicklung: http://localhost:3000
# Produktion:  https://panel.neuhauser.app
BETTER_AUTH_URL="http://localhost:3000"

# --- Node-Agent --------------------------------------------------------------
# Der Agent läuft als systemd-Unit auf dem Host und lauscht nur lokal.
AGENT_URL="http://127.0.0.1:8787"
AGENT_TOKEN="dev-token-bitte-ersetzen"

# --- Mailversand -------------------------------------------------------------
# "console" schreibt Verifizierungslinks ins Terminal statt sie zu versenden.
MAIL_TRANSPORT="console"
MAIL_FROM="noreply@neuhauser.app"

# --- Node-Eckdaten für `pnpm db:seed` ----------------------------------------
# Zielhardware: Intel i5-12500 (6 Kerne / 12 Threads), 48 GB RAM,
#               256 GB SSD (System + Docker), 1 TB SSD (ZFS-Pool "tank").
#
# Reserviert (12 GB): 6 GB ZFS-ARC + 2 GB OS + 4 GB Postgres/Redis/App/Agent.
# Bleiben 36 GB für Server — also 9 Stück à 4 GB.
NODE_TOTAL_MEMORY_MB=49152
NODE_TOTAL_CPU_CORES=12
NODE_TOTAL_DISK_MB=953000
NODE_RESERVED_MEMORY_MB=12288
NODE_RESERVED_DISK_MB=190000
NODE_PUBLIC_HOST=mc.neuhauser.app
