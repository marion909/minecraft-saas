[Unit]
Description=Minecraft-SaaS Node-Agent
Documentation=https://github.com/marion909/minecraft-saas
After=network-online.target docker.service zfs.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=mcagent
Group=mcsaas
WorkingDirectory=/opt/mc-saas/app

# Node führt die TypeScript-Dateien direkt aus und strippt dabei die Typen.
ExecStart=/usr/bin/node agent/index.ts

Restart=always
RestartSec=5

# Diese Unit ist bewusst ungehärtet. Die Begründung gehört hierher, weil
# der Reflex sonst ist, die üblichen Protect*-Zeilen wieder einzusetzen —
# und dann bricht wieder etwas, ohne eine Fehlermeldung zu hinterlassen.
#
# 1. ProtectSystem, ProtectHome, PrivateTmp, ProtectKernelTunables und
#    ProtectControlGroups geben dem Dienst je einen eigenen
#    Mount-Namensraum, dessen Weitergabe systemd auf "slave" setzt:
#    Einhängungen vom Host kommen herein, eigene gehen nicht hinaus. Der
#    Agent hängt pro Server ein ZFS-Dataset ein und Docker läuft im
#    Namensraum des Hosts — der Container bekäme ein leeres Verzeichnis
#    untergeschoben und legte die Welt am falschen Ort ab.
#
# 2. NoNewPrivileges lässt sudo scheitern, und der Agent braucht sudo für
#    mc-zfs-helper: Ein- und Aushängen verlangt unter Linux Benutzer-ID 0,
#    `zfs allow` deckt es nicht ab und CAP_SYS_ADMIN genügt ZFS auch nicht.
#    ProtectKernelModules, RestrictSUIDSGID, RestrictRealtime und
#    LockPersonality setzen NoNewPrivileges implizit mit — deshalb sind
#    auch sie hier nicht zu gebrauchen.
#
# Was bleibt: Der Agent läuft als mcagent, nicht als root. Die
# Dateiverwaltung — der einzige Teil, der Benutzereingaben in Pfade
# übersetzt — arbeitet damit unprivilegiert, und die Schreibgrenze ziehen
# die Dateisystem-Rechte: mcagent gehört /srv/mc und /srv/backups.
#
# Ehrlich dazu: Über die Docker-Gruppe ist mcagent auf diesem Host
# root-gleichwertig, sobald jemand Code darunter ausführen kann. Die
# Trennung hilft gegen Fehler im Agent, nicht gegen einen Angreifer, der
# ihn schon übernommen hat.

# Diese vier bleiben, und zwar ambient — im Bounding-Set allein wirken sie
# nicht. Ohne CAP_SYS_ADMIN scheitert schon `zfs create` mit "permission
# denied", obwohl die Delegation stimmt: ZFS verlangt für create die
# mount-Fähigkeit gleich mit. Zum tatsächlichen Einhängen reicht die
# Capability trotzdem nicht — dafür gibt es mc-zfs-helper.
#
# Bewusst ohne CapabilityBoundingSet: Ein enges Bounding-Set nähme auch
# dem über sudo gestarteten Helfer die Rechte, die er braucht.
AmbientCapabilities=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-agent

[Install]
WantedBy=multi-user.target
